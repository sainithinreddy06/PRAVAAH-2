APP_NAME=PRAVAAH API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://pravaah:pravaah@localhost:5432/pravaah
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
EVIDENCE_STORAGE_DIR=.data/evidence
MAX_EVIDENCE_SIZE_BYTES=10485760
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT_URL=
EVIDENCE_S3_PREFIX=evidence
EVIDENCE_MALWARE_SCANNING_ENABLED=false
EVIDENCE_CLAMAV_HOST=
EVIDENCE_CLAMAV_PORT=3310
EVIDENCE_CLAMAV_TIMEOUT_SECONDS=10
